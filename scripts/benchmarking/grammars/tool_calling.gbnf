root   ::= object
object ::= "{" ws "\"thought\":" ws string "," ws "\"tool\":" ws string "," ws "\"args\":" ws dict "," ws "\"final_answer\":" ws string ws "}"
dict   ::= "{" ws (kv ("," ws kv)*)? "}"
kv     ::= string ":" ws value
value  ::= string | number | dict | list | "true" | "false" | "null"
string ::= "\"" ([^"\\] | "\\" ["\\/bfnrt] | "\\u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])* "\""
number ::= "-"? ([0-9] | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
list   ::= "[" ws (value ("," ws value)*)? "]"
ws     ::= [ \t\n\r]*
