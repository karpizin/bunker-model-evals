        {"type": "contains_any", "values": ["rsync", "cp", "dd"], "weight": 2},
        {"type": "contains_all", "values": ["/media/bunkerai/BUNKERUSB", "local-imports"], "weight": 2},
        {"type": "contains_any", "values": ["stat", "sha256", "размер", "свер"], "weight": 2},
        {"type": "contains_any", "values": ["sync", "umount", "отмонт"], "weight": 1},
        {"type": "not_contains_any", "values": ["скопировал", "готово", "перенес"], "weight": 2},
        {"type": "no_thought_leak", "weight": 2}
