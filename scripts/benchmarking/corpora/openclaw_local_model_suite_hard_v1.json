{
  "suite_id": "openclaw_local_model_suite_hard_v1",
  "title": "OpenClaw Local Model Integration Suite - Hard",
  "description": "A harder OpenClaw-oriented benchmark for local GGUF models. The score is not capped; the tasks are simply more demanding, with multi-constraint prompts, stricter structure checks, safer tool routing, operational judgment, and product-grade assistant behavior.",
  "cases": [
    {
      "id": "hard_ops_incident_triage_conflicting_work",
      "category": "ops",
      "mode": "chat",
      "prompt": "Мы одновременно копируем модели на флешку, aria2 качает большие GGUF, и Docker build завис на whisper. Пользователь раздражен и просит 'почистить лишнее'. Дай короткий план из 4 шагов: что проверить, что нельзя трогать, что можно безопасно остановить, и какой следующий апдейт дать.",
      "checks": [
        {"type": "contains_all", "values": ["aria2", "docker", "флеш"], "weight": 3},
        {"type": "contains_any", "values": ["не трог", "не удал", "не останавливать"], "weight": 2},
        {"type": "contains_any", "values": ["провер", "ps", "logs", "статус"], "weight": 2},
        {"type": "contains_any", "values": ["апдейт", "сообщ"], "weight": 1},
        {"type": "count_regex_between", "value": "(^|\\n)\\s*(\\d+\\.|-|\\*)\\s+", "min": 3, "max": 6, "weight": 2},
        {"type": "no_thought_leak", "weight": 3}
      ]
    },
    {
      "id": "hard_usb_copy_integrity_plan",
      "category": "ops",
      "mode": "chat",
